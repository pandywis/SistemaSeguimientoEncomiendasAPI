@page
@model Encomiendas.Web.Pages.Reportes.CreateModel
@{
    ViewData["Title"] = "Crear reporte";
}

<h2>Crear reporte</h2>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Titulo" class="form-label"></label>
        <input asp-for="Input.Titulo" class="form-control" />
        <span asp-validation-for="Input.Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Contenido" class="form-label"></label>
        <textarea asp-for="Input.Contenido" class="form-control"></textarea>
        <span asp-validation-for="Input.Contenido" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Crear</button>
    <a asp-page="/Reportes/Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
